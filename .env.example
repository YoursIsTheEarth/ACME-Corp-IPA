# Copy to .env and adjust. Every setting is shown with its default.

# Storage
DB_PATH=acme.db

# LLM provider: grok (default) or claude. The app needs the matching API key to process invoices.
LLM_PROVIDER=grok
GROK_MODEL=grok-4
CLAUDE_MODEL=claude-sonnet-5-5
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3
XAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional per-role provider overrides (P1, cross-model critique); empty = use LLM_PROVIDER
LLM_PROVIDER_EXTRACTION=
LLM_PROVIDER_VALIDATION=
LLM_PROVIDER_APPROVAL=
LLM_PROVIDER_CRITIC=

# FX: USD per one unit of foreign currency
FX_RATES={"EUR": "1.08"}

# Validation
PRICE_VARIANCE_PCT=10
NEAR_THRESHOLD_FLOOR_USD=9500.00
FRAUD_SIGNAL_WEIGHTS={"urgency_language": 0.25, "wire_transfer": 0.25, "immediate_terms": 0.15, "relative_due_date": 0.15, "unknown_vendor": 0.20, "suspicious_address": 0.30, "near_threshold": 0.10, "payee_cumulative": 0.25, "prompt_injection": 0.60}
FRAUD_THRESHOLD=0.60

# Payee registry: invoices to one payee (by name, alias, or remit-to address) summed over a rolling window
PAYEE_WINDOW_DAYS=30
PAYEE_CUMULATIVE_THRESHOLD_USD=10000.00

# Approval
VP_REVIEW_THRESHOLD_USD=10000.00
CRITIC_MAX_ROUNDS=2
EXTRACTION_MAX_RETRIES=2
VALIDATION_MAX_TOOL_ROUNDS=8

# Payments (batch timing is set on the Admin page or with `python main.py admin set`)
PAYMENT_IDLE_DELAY_S=60
PAYMENT_MAX_ATTEMPTS=3
PAYMENT_LOCK_TIMEOUT_S=30

# API
API_CORS_ORIGIN=http://localhost:4200
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=10485760
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.txt,.csv,.json,.xml,.eml
WORKER_CONCURRENCY=1
